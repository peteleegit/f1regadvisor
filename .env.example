# Copy to .env and fill in values, or use .streamlit/secrets.toml instead.
# Environment variables override secrets.toml.

# --- FIARulerPro connection (required) ---
# URL of the FIARulerPro /retrieve endpoint
F1REG_FIARULER_API_URL=http://localhost:8000
# Bearer token; must match FIARULER_RETRIEVE_API_KEY on the FIARulerPro side
F1REG_FIARULER_API_KEY=

# --- Anthropic API (required) ---
# Can also be set via .streamlit/secrets.toml
ANTHROPIC_API_KEY=sk-ant-...

# --- Model selection (optional; defaults shown) ---
# F1REG_FAST_MODEL=claude-haiku-4-5-20251001
# F1REG_PRIMARY_MODEL=claude-sonnet-4-6
# F1REG_SENIOR_MODEL=claude-opus-4-7
# F1REG_VERDICT_MODEL=claude-opus-4-7

# --- Pipeline tuning (optional; defaults shown) ---
# F1REG_DEFAULT_SEASON=2026
# F1REG_REGULATION_LIMIT=10
# F1REG_PRECEDENT_LIMIT=8
